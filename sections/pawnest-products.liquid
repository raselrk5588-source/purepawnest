<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
<style>
    .pawnest-prods-{{ section.id }} { font-family: 'Outfit', sans-serif; background: {{ section.settings.bg_color }}; padding-bottom: 80px; }
    .section-header-{{ section.id }} { display: flex; justify-content: space-between; align-items: center; padding: 60px 5% 30px; }
    .section-header-{{ section.id }} h3 { font-size: 36px; font-weight: 800; color: #2C3E50; margin: 0; }

    .product-grid-{{ section.id }} { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; padding: 0 5%; }
    .product-card-{{ section.id }} { background: white; border-radius: 20px; padding: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.02); transition: all 0.3s ease; text-decoration: none; display: block; position: relative;}
    .product-card-{{ section.id }}:hover { transform: translateY(-8px); box-shadow: 0 15px 30px rgba(0,0,0,0.08); }
    
    .product-img-{{ section.id }} { height: 250px; border-radius: 15px; margin-bottom: 20px; background-size: cover; background-position: center; background-color: #F0F2F5;}
    .product-card-{{ section.id }} h4 { font-size: 18px; font-weight: 600; color: #2C3E50; margin-bottom: 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3;}
    
    .price-row-{{ section.id }} { display: flex; justify-content: space-between; align-items: center; }
    .price-{{ section.id }} { font-size: 20px; font-weight: 800; color: #FF7E67; }
    
    .add-form-{{ section.id }} { margin: 0; }
    .add-btn-{{ section.id }} { background: #2C3E50; color: white; padding: 8px 15px; border-radius: 10px; border: none; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 5px; transition: background 0.3s; }
    .add-btn-{{ section.id }}:hover { background: #FF7E67; }
    .add-btn-{{ section.id }} .icon { display: none; }

    @media (max-width: 768px) {
        .pawnest-prods-{{ section.id }} { padding-bottom: 30px; }
        .section-header-{{ section.id }} { padding: 20px 20px 10px; }
        .section-header-{{ section.id }} h3 { font-size: 20px; }
        
        .product-grid-{{ section.id }} { grid-template-columns: 1fr 1fr; gap: 15px; padding: 0 20px; }
        .product-card-{{ section.id }} { padding: 12px; border-radius: 16px; }
        .product-img-{{ section.id }} { height: 140px; border-radius: 12px; margin-bottom: 10px; }
        .product-card-{{ section.id }} h4 { font-size: 13px; }
        .price-{{ section.id }} { font-size: 15px; }
        
        .add-btn-{{ section.id }} { width: 32px; height: 32px; padding: 0; border-radius: 8px; justify-content: center; }
        .add-btn-{{ section.id }} .text { display: none; }
        .add-btn-{{ section.id }} .icon { display: block !important; font-size: 18px; }
    }
</style>

<div class="pawnest-prods-{{ section.id }}">
    <div class="section-header-{{ section.id }}">
        <h3>{{ section.settings.title }}</h3>
    </div>
    
    <div class="product-grid-{{ section.id }}">
        {% assign collection = collections[section.settings.collection] %}
        
        {% if collection != blank and collection.products_count > 0 %}
            {% for product in collection.products limit: section.settings.limit %}
                <div class="product-card-{{ section.id }}">
                    <a href="{{ product.url }}" style="text-decoration: none;">
                        <div class="product-img-{{ section.id }}" style="background-image: url('{{ product.featured_image | img_url: '600x600', crop: 'center' }}');"></div>
                        <h4>{{ product.title }}</h4>
                    </a>
                    <div class="price-row-{{ section.id }}">
                        <div class="price-{{ section.id }}">{{ product.price | money }}</div>
                        <form method="post" action="/cart/add" class="add-form-{{ section.id }}">
                            <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                            <button type="submit" class="add-btn-{{ section.id }}">
                                <span class="text">+ Add</span>
                                <span class="material-icons-round icon">add</span>
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <!-- Demo Content -->
            {% for i in (1..4) %}
                <div class="product-card-{{ section.id }}">
                    <div class="product-img-{{ section.id }}"></div>
                    <h4>Import CJ Product</h4>
                    <div class="price-row-{{ section.id }}">
                        <div class="price-{{ section.id }}">$24.99</div>
                        <button class="add-btn-{{ section.id }}">
                            <span class="text">+ Add</span>
                            <span class="material-icons-round icon">add</span>
                        </button>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

{% schema %}
{
  "name": "App-Style Products",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Trending Now" },
    { "type": "collection", "id": "collection", "label": "Select Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 2, "label": "Product Limit", "default": 4 },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F8F9FA" }
  ],
  "presets": [ { "name": "App-Style Products", "category": "PawNest" } ]
}
{% endschema %}
