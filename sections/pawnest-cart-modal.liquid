<style>
        /* Cart Drawer */
        .cart-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 1999;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
        }
        .cart-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        .cart-drawer {
            position: fixed;
            top: 0; right: -400px;
            width: 100%;
            max-width: 400px;
            height: 100vh;
            background: white;
            z-index: 2000;
            box-shadow: -5px 0 30px rgba(0,0,0,0.1);
            transition: right 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .cart-drawer.active {
            right: 0;
        }
        .cart-header {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
        }
        .cart-header h2 {
            font-family: 'Oswald', sans-serif;
            margin: 0;
            color: var(--secondary);
            text-transform: uppercase;
        }
        .close-cart {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--text-light);
        }
        .cart-items-container {
            flex-grow: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .cart-item {
            display: flex;
            gap: 15px;
            align-items: center;
            padding-bottom: 15px;
            border-bottom: 1px solid #f0f0f0;
        }
        .cart-item-checkbox {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: var(--primary);
        }
        .cart-item-img {
            width: 70px;
            height: 70px;
            background-size: cover;
            border-radius: 8px;
        }
        .cart-item-details {
            flex-grow: 1;
        }
        .cart-item-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--secondary);
            margin-bottom: 5px;
        }
        .cart-item-price {
            color: var(--primary);
            font-weight: 700;
            font-family: 'Oswald', sans-serif;
        }
        .cart-item-remove {
            color: #ff4d4f;
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
        }
        .cart-footer {
            padding: 20px;
            border-top: 1px solid #eee;
            background: #fafafa;
        }
        .cart-total {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: 700;
            font-family: 'Oswald', sans-serif;
            color: var(--secondary);
            margin-bottom: 15px;
        }
        .checkout-btn {
            width: 100%;
            background: var(--primary);
            color: white;
            border: none;
            padding: 15px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 700;
            font-family: 'Oswald', sans-serif;
            text-transform: uppercase;
            cursor: pointer;
            transition: background 0.3s;
        }
        .checkout-btn:hover { background: var(--secondary); }
        .checkout-btn:disabled { background: #ccc; cursor: not-allowed; }
        .empty-cart-msg { text-align: center; color: var(--text-light); margin-top: 50px; }
        
        /* Product Details Modal */
        .product-modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
            z-index: 1990; display: flex; justify-content: center; align-items: center;
            opacity: 0; visibility: hidden; transition: all 0.3s ease;
        }
        .product-modal-overlay.active { opacity: 1; visibility: visible; }
        .product-modal {
            background: white; width: 90%; max-width: 1000px; height: 80vh;
            border-radius: 20px; display: flex; position: relative; overflow: hidden;
            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
            transform: translateY(20px) scale(0.95); transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .product-modal-overlay.active .product-modal { transform: translateY(0) scale(1); }
        .close-modal {
            position: absolute; top: 15px; right: 15px; background: #f0f0f0; border: none;
            width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            cursor: pointer; z-index: 10; transition: background 0.3s;
        }
        .close-modal:hover { background: #e0e0e0; color: var(--primary); }
        .modal-left { flex: 2; padding: 40px; display: flex; flex-direction: column; overflow-y: auto; border-right: 1px solid #eee; }
        .modal-main-img { width: 100%; height: 350px; background-size: cover; background-position: center; border-radius: 16px; margin-bottom: 30px; box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
        .modal-info h2 { font-family: 'Oswald', sans-serif; font-size: 32px; color: var(--secondary); margin-bottom: 10px; }
        .modal-price { font-size: 24px; font-weight: 700; color: var(--primary); font-family: 'Oswald', sans-serif; margin-bottom: 20px; }
        .modal-desc { color: var(--text-light); line-height: 1.6; margin-bottom: 30px; font-size: 15px; }
        .modal-add-btn { background: var(--primary); color: white; border: none; padding: 15px 30px; border-radius: 30px; font-size: 16px; font-weight: 700; font-family: 'Oswald', sans-serif; text-transform: uppercase; cursor: pointer; transition: all 0.3s; width: 100%; }
        .modal-add-btn:hover { background: var(--secondary); transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .modal-right { flex: 1; background: #fafafa; display: flex; flex-direction: column; }
        .modal-right h3 { padding: 25px 25px 15px; margin: 0; font-family: 'Oswald', sans-serif; color: var(--secondary); font-size: 18px; text-transform: uppercase; border-bottom: 1px solid #eee; }
        .modal-product-list { flex-grow: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 15px; }
        .modal-small-item { display: flex; gap: 15px; padding: 10px; background: white; border-radius: 12px; border: 1px solid #eee; cursor: pointer; transition: all 0.2s; }
        .modal-small-item:hover { border-color: var(--primary); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .modal-small-img { width: 60px; height: 60px; border-radius: 8px; background-size: cover; background-position: center; }
        .modal-small-info { flex-grow: 1; display: flex; flex-direction: column; justify-content: center; }
        .modal-small-title { font-size: 13px; font-weight: 600; color: var(--secondary); margin-bottom: 5px; }
        .modal-small-price { font-size: 14px; font-weight: 700; color: var(--primary); }
        @media (max-width: 768px) {
            .product-modal { flex-direction: column; height: 90vh; width: 95%; }
            .modal-left { padding: 20px; border-right: none; border-bottom: 1px solid #eee; }
            .modal-main-img { height: 250px; margin-bottom: 20px; }
            .modal-right { flex: 1; min-height: 250px; }
        }

        @keyframes cartBump {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); }
            100% { transform: scale(1); }
        }
        .cart-bump {
            animation: cartBump 0.3s ease-in-out;
        }
    </style>
</style>
    <!-- Cart Drawer -->
    <div class="cart-overlay" id="cartOverlay"></div>
    <div class="cart-drawer" id="cartDrawer">
        <div class="cart-header">
            <h2>Your Cart</h2>
            <button class="close-cart" id="closeCartBtn"><span class="material-icons-round">close</span></button>
        </div>
        <div class="cart-items-container" id="cartItemsContainer">
            <!-- Items will be injected here via JS -->
            <div class="empty-cart-msg">Your cart is empty.</div>
        </div>
        <div class="cart-footer">
            <div class="cart-total">
                <span>Selected Total:</span>
                <span id="cartTotalAmount">$0.00</span>
            </div>
            <button class="checkout-btn" id="checkoutBtn" disabled>Place Order</button>
        </div>
    </div>

    <!-- Product Details Modal -->
    <div class="product-modal-overlay" id="productModalOverlay">
        <div class="product-modal" id="productModal">
            <button class="close-modal" id="closeModalBtn"><span class="material-icons-round">close</span></button>
            <div class="modal-left">
                <div class="modal-main-img" id="modalMainImg"></div>
                <div class="modal-info">
                    <h2 id="modalTitle">Product Title</h2>
                    <div class="modal-price" id="modalPrice">$0.00</div>
                    <p class="modal-desc">This is a premium product for your beloved pet. Designed with care and made from high-quality materials to ensure durability and fun.</p>
                    <button class="modal-add-btn" id="modalAddBtn">Add to Cart</button>
                </div>
            </div>
            <div class="modal-right">
                <h3>More Products</h3>
                <div class="modal-product-list" id="modalProductList">
                    <!-- Javascript will inject list of other products here -->
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Cart Logic
            let cart = [];
            const suggestedItems = [
                {
                    title: 'Organic Dog Treats',
                    price: 9.99,
                    img: "url('https://images.unsplash.com/photo-1582457380669-7c152a5c43d7?q=80&w=200')"
                },
                {
                    title: 'Catnip Mouse Toy',
                    price: 5.50,
                    img: "url('https://images.unsplash.com/photo-1615689108154-18c7d6c6ffc6?q=80&w=200')"
                }
            ];
            const cartOverlay = document.getElementById('cartOverlay');
            const cartDrawer = document.getElementById('cartDrawer');
            const closeCartBtn = document.getElementById('closeCartBtn');
            const cartItemsContainer = document.getElementById('cartItemsContainer');
            const cartTotalAmount = document.getElementById('cartTotalAmount');
            const checkoutBtn = document.getElementById('checkoutBtn');
            
            // Open cart
            document.querySelectorAll('.cart-wrapper').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    cartOverlay.classList.add('active');
                    cartDrawer.classList.add('active');
                });
            });
            
            // Close cart
            function closeCart() {
                cartOverlay.classList.remove('active');
                cartDrawer.classList.remove('active');
            }
            closeCartBtn.addEventListener('click', closeCart);
            cartOverlay.addEventListener('click', closeCart);
            
            // Add to cart
            document.querySelectorAll('.add-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const card = this.closest('.product-card');
                    if(card) {
                        const title = card.querySelector('h4').innerText;
                        const priceText = card.querySelector('.price').innerText;
                        const price = parseFloat(priceText.replace('$', ''));
                        const productImgEl = card.querySelector('.product-img');
                        const bgImage = productImgEl.style.backgroundImage;
                        
                        // Add to cart array
                        cart.push({
                            id: Date.now(),
                            title: title,
                            price: price,
                            img: bgImage,
                            selected: true
                        });
                        
                        updateCartUI();
                        
                        // Create flying image animation
                        const clone = productImgEl.cloneNode(true);
                        const rect = productImgEl.getBoundingClientRect();
                        
                        clone.style.position = 'fixed';
                        clone.style.top = rect.top + 'px';
                        clone.style.left = rect.left + 'px';
                        clone.style.width = rect.width + 'px';
                        clone.style.height = rect.height + 'px';
                        clone.style.zIndex = '9999';
                        clone.style.transition = 'all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                        clone.style.borderRadius = '12px';
                        clone.style.opacity = '1';
                        document.body.appendChild(clone);
                        
                        // Get visible cart icon
                        let targetCart = document.querySelector('.header-icons .cart-wrapper');
                        if (window.innerWidth <= 768) {
                            targetCart = document.querySelector('.bottom-nav .cart-wrapper');
                        }
                        const targetRect = targetCart.getBoundingClientRect();
                        
                        // Trigger animation
                        setTimeout(() => {
                            clone.style.top = (targetRect.top + targetRect.height/2 - 10) + 'px';
                            clone.style.left = (targetRect.left + targetRect.width/2 - 10) + 'px';
                            clone.style.width = '20px';
                            clone.style.height = '20px';
                            clone.style.opacity = '0.2';
                        }, 10);
                        
                        setTimeout(() => {
                            clone.remove();
                            targetCart.classList.add('cart-bump');
                            setTimeout(() => targetCart.classList.remove('cart-bump'), 300);
                        }, 800);
                    }
                });
            });

            // Upsell add to cart
            const upsellBtn = document.querySelector('.upsell-btn');
            if(upsellBtn) {
                upsellBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    cart.push({
                        id: Date.now(),
                        title: 'Bundle & Save 20%',
                        price: 54.99,
                        img: "url('https://images.unsplash.com/photo-1605634563499-1bd62de2877a?q=80&w=200')",
                        selected: true
                    });
                    updateCartUI();
                    
                    let targetCart = document.querySelector('.header-icons .cart-wrapper');
                    if (window.innerWidth <= 768) {
                        targetCart = document.querySelector('.bottom-nav .cart-wrapper');
                    }
                    targetCart.classList.add('cart-bump');
                    setTimeout(() => targetCart.classList.remove('cart-bump'), 300);
                });
            }
            
            function updateCartUI() {
                // Update counts
                document.querySelectorAll('.cart-count').forEach(el => {
                    el.innerText = cart.length;
                    if(cart.length > 0) {
                        el.style.display = 'flex';
                    } else {
                        el.style.display = 'none';
                    }
                });
                
                cartItemsContainer.innerHTML = '';
                let total = 0;
                let anySelected = false;
                
                if (cart.length === 0) {
                    cartItemsContainer.innerHTML = '<div class="empty-cart-msg" style="margin-bottom: 20px;">Your cart is empty.</div>';
                }
                
                cart.forEach((item, index) => {
                    if (item.selected) {
                        total += item.price;
                        anySelected = true;
                    }
                    
                    const itemEl = document.createElement('div');
                    itemEl.className = 'cart-item';
                    itemEl.innerHTML = `
                        <input type="checkbox" class="cart-item-checkbox" data-index="${index}" ${item.selected ? 'checked' : ''}>
                        <div class="cart-item-img" style='background-image: ${item.img.replace(/'/g, "\"")}'></div>
                        <div class="cart-item-details">
                            <div class="cart-item-title">${item.title}</div>
                            <div class="cart-item-price">$${item.price.toFixed(2)}</div>
                        </div>
                        <button class="cart-item-remove" data-index="${index}"><span class="material-icons-round">delete</span></button>
                    `;
                    cartItemsContainer.appendChild(itemEl);
                });
                
                cartTotalAmount.innerText = '$' + total.toFixed(2);
                checkoutBtn.disabled = !anySelected;

                // Add suggested items section
                const suggestionsHeader = document.createElement('h3');
                suggestionsHeader.innerText = 'You may also like';
                suggestionsHeader.style.fontSize = '14px';
                suggestionsHeader.style.fontFamily = "'Oswald', sans-serif";
                suggestionsHeader.style.textTransform = 'uppercase';
                suggestionsHeader.style.color = 'var(--secondary)';
                suggestionsHeader.style.marginTop = '20px';
                suggestionsHeader.style.marginBottom = '10px';
                suggestionsHeader.style.borderBottom = '1px solid #eee';
                suggestionsHeader.style.paddingBottom = '5px';
                
                let appendedHeader = false;

                suggestedItems.forEach((sugg, index) => {
                    if (cart.some(c => c.title === sugg.title)) return;
                    
                    if (!appendedHeader) {
                        cartItemsContainer.appendChild(suggestionsHeader);
                        appendedHeader = true;
                    }

                    const suggEl = document.createElement('div');
                    suggEl.className = 'cart-item';
                    suggEl.style.opacity = '0.7';
                    suggEl.innerHTML = `
                        <button class="add-sugg-btn" data-index="${index}" style="background:none;border:none;color:var(--primary);cursor:pointer;width:20px;height:20px;display:flex;align-items:center;justify-content:center;padding:0;" title="Add to cart">
                            <span class="material-icons-round" style="font-size:24px;">add_circle_outline</span>
                        </button>
                        <div class="cart-item-img" style='background-image: ${sugg.img.replace(/'/g, "\"")}'></div>
                        <div class="cart-item-details">
                            <div class="cart-item-title">${sugg.title}</div>
                            <div class="cart-item-price">$${sugg.price.toFixed(2)}</div>
                        </div>
                    `;
                    cartItemsContainer.appendChild(suggEl);
                });
                
                // Add listeners to new elements
                document.querySelectorAll('.cart-item-checkbox').forEach(cb => {
                    cb.addEventListener('change', function() {
                        const idx = this.getAttribute('data-index');
                        cart[idx].selected = this.checked;
                        updateCartUI();
                    });
                });
                
                document.querySelectorAll('.cart-item-remove').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const idx = this.getAttribute('data-index');
                        cart.splice(idx, 1);
                        updateCartUI();
                    });
                });

                document.querySelectorAll('.add-sugg-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const idx = this.getAttribute('data-index');
                        const item = suggestedItems[idx];
                        cart.push({
                            id: Date.now(),
                            title: item.title,
                            price: item.price,
                            img: item.img,
                            selected: true
                        });
                        updateCartUI();
                    });
                });
            }
            
            checkoutBtn.addEventListener('click', () => {
                alert('Order placed successfully!');
                cart = cart.filter(item => !item.selected);
                updateCartUI();
                closeCart();
            });
            
            // Product Modal Logic
            const productModalOverlay = document.getElementById('productModalOverlay');
            const closeModalBtn = document.getElementById('closeModalBtn');
            const modalMainImg = document.getElementById('modalMainImg');
            const modalTitle = document.getElementById('modalTitle');
            const modalPrice = document.getElementById('modalPrice');
            const modalAddBtn = document.getElementById('modalAddBtn');
            const modalProductList = document.getElementById('modalProductList');

            const allProducts = [];
            document.querySelectorAll('.product-grid .product-card').forEach(card => {
                allProducts.push({
                    title: card.querySelector('h4').innerText,
                    priceText: card.querySelector('.price').innerText,
                    price: parseFloat(card.querySelector('.price').innerText.replace('$', '')),
                    img: card.querySelector('.product-img').style.backgroundImage
                });
            });

            function openProductModal(product) {
                modalMainImg.style.backgroundImage = product.img;
                modalTitle.innerText = product.title;
                modalPrice.innerText = product.priceText;
                
                modalAddBtn.onclick = () => {
                    cart.push({
                        id: Date.now(),
                        title: product.title,
                        price: product.price,
                        img: product.img,
                        selected: true
                    });
                    updateCartUI();
                    
                    const clone = modalMainImg.cloneNode(true);
                    const rect = modalMainImg.getBoundingClientRect();
                    clone.style.position = 'fixed';
                    clone.style.top = rect.top + 'px';
                    clone.style.left = rect.left + 'px';
                    clone.style.width = rect.width + 'px';
                    clone.style.height = rect.height + 'px';
                    clone.style.zIndex = '9999';
                    clone.style.transition = 'all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                    clone.style.borderRadius = '16px';
                    document.body.appendChild(clone);
                    
                    let targetCart = document.querySelector('.header-icons .cart-wrapper');
                    if (window.innerWidth <= 768) {
                        targetCart = document.querySelector('.bottom-nav .cart-wrapper');
                    }
                    const targetRect = targetCart.getBoundingClientRect();
                    
                    setTimeout(() => {
                        clone.style.top = (targetRect.top + targetRect.height/2 - 10) + 'px';
                        clone.style.left = (targetRect.left + targetRect.width/2 - 10) + 'px';
                        clone.style.width = '20px';
                        clone.style.height = '20px';
                        clone.style.opacity = '0.2';
                    }, 10);
                    
                    setTimeout(() => {
                        clone.remove();
                        targetCart.classList.add('cart-bump');
                        setTimeout(() => targetCart.classList.remove('cart-bump'), 300);
                        productModalOverlay.classList.remove('active');
                    }, 800);
                };

                modalProductList.innerHTML = '';
                allProducts.forEach(p => {
                    if (p.title === product.title) return;
                    const pEl = document.createElement('div');
                    pEl.className = 'modal-small-item';
                    pEl.innerHTML = `
                        <div class="modal-small-img" style='background-image: ${p.img.replace(/'/g, "\"")}'></div>
                        <div class="modal-small-info">
                            <div class="modal-small-title">${p.title}</div>
                            <div class="modal-small-price">${p.priceText}</div>
                        </div>
                    `;
                    pEl.onclick = () => openProductModal(p);
                    modalProductList.appendChild(pEl);
                });

                productModalOverlay.classList.add('active');
            }

            closeModalBtn.addEventListener('click', () => productModalOverlay.classList.remove('active'));
            productModalOverlay.addEventListener('click', (e) => {
                if(e.target === productModalOverlay) productModalOverlay.classList.remove('active');
            });

            document.querySelectorAll('.product-grid .product-card').forEach(card => {
                card.addEventListener('click', function(e) {
                    if (e.target.closest('.add-btn')) return;
                    e.preventDefault();
                    const title = this.querySelector('h4').innerText;
                    const product = allProducts.find(p => p.title === title);
                    if (product) openProductModal(product);
                });
            });

            // Initialize empty cart
            updateCartUI();
        });
    </script>
