<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
    .pawnest-app-header-{{ section.id }} {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 80px;
        background: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 4%;
        z-index: 1000;
        box-shadow: 0 2px 15px rgba(0,0,0,0.06);
        font-family: 'Outfit', sans-serif;
    }

    .pawnest-logo-{{ section.id }} { 
        font-size: 34px; 
        font-weight: 900; 
        color: {{ section.settings.primary_color }}; 
        text-decoration: none; 
        letter-spacing: -1.5px; 
        font-family: 'Oswald', sans-serif;
        text-transform: uppercase;
        display: flex;
        align-items: center;
    }
    .pawnest-logo-{{ section.id }} span { 
        color: {{ section.settings.secondary_color }}; 
    }

    .pawnest-desktop-nav-{{ section.id }} { 
        display: flex; 
        gap: 2vw; 
        align-items: center; 
        height: 100%;
    }
    
    .pawnest-nav-item {
        height: 100%;
        display: flex;
        align-items: center;
        position: relative;
    }

    .pawnest-nav-link { 
        text-decoration: none; 
        color: {{ section.settings.secondary_color }}; 
        font-weight: 600; 
        font-size: 16px; 
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: color 0.3s ease;
        display: flex;
        align-items: center;
        gap: 2px;
        font-family: 'Oswald', sans-serif;
    }
    
    .pawnest-nav-link .material-icons-round {
        font-size: 20px;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .pawnest-nav-item:hover .pawnest-nav-link { 
        color: {{ section.settings.primary_color }}; 
    }
    .pawnest-nav-item:hover .material-icons-round { 
        transform: rotate(180deg); 
    }

    /* Dropdown CSS */
    .pawnest-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(15px);
        background: #ffffff;
        min-width: 220px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.12);
        border-radius: 8px;
        padding: 12px 0;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(0,0,0,0.05);
    }
    
    /* Small arrow on top of dropdown */
    .pawnest-dropdown-menu::before {
        content: '';
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%) rotate(45deg);
        width: 12px;
        height: 12px;
        background: #ffffff;
        border-left: 1px solid rgba(0,0,0,0.05);
        border-top: 1px solid rgba(0,0,0,0.05);
    }

    .pawnest-nav-item:hover .pawnest-dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    .pawnest-dropdown-menu a {
        padding: 10px 24px;
        text-transform: none;
        font-weight: 500;
        font-size: 15px;
        color: {{ section.settings.secondary_color }};
        text-decoration: none;
        transition: all 0.2s ease;
        font-family: 'Outfit', sans-serif;
        position: relative;
        z-index: 1;
        display: block;
    }
    
    .pawnest-dropdown-menu a:hover {
        background: rgba(0,0,0,0.03);
        color: {{ section.settings.primary_color }};
        padding-left: 30px;
    }

    .pawnest-header-icons-{{ section.id }} { 
        display: flex; 
        gap: 10px; 
        align-items: center; 
    }
    
    .pawnest-icon-link { 
        cursor: pointer; 
        color: {{ section.settings.secondary_color }}; 
        transition: color 0.3s, transform 0.2s, background 0.3s; 
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
    }
    
    .pawnest-icon-link .material-icons-round {
        font-size: 24px;
    }
    
    .pawnest-icon-link:hover { 
        color: {{ section.settings.primary_color }}; 
        background: rgba(0,0,0,0.04);
        transform: translateY(-2px);
    }

    .pawnest-cart-icon-wrapper {
        position: relative;
    }
    
    .cart-count-bubble {
        position: absolute;
        top: 4px;
        right: 4px;
        background-color: {{ section.settings.primary_color }};
        color: white;
        font-size: 11px;
        font-weight: 700;
        width: 18px;
        height: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        line-height: 1;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    @media (max-width: 990px) {
        .pawnest-app-header-{{ section.id }} { height: 70px; padding: 0 20px; }
        .pawnest-logo-{{ section.id }} { font-size: 26px; }
        .pawnest-desktop-nav-{{ section.id }} { display: none; }
        .pawnest-icon-link { width: 38px; height: 38px; }
        .pawnest-icon-link .material-icons-round { font-size: 22px; }
    }
    
    /* Global padding for body to prevent overlap */
    body { padding-top: 80px; }
    @media (max-width: 990px) { body { padding-top: 70px; } }
</style>

<header class="pawnest-app-header-{{ section.id }}">
    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="pawnest-logo-{{ section.id }}">
        {% if section.settings.logo_image != blank %}
            <img src="{{ section.settings.logo_image | image_url: width: section.settings.logo_width }}" alt="{{ shop.name }}" style="max-width: {{ section.settings.logo_width }}px; height: auto;">
        {% else %}
            {{ section.settings.logo_text_1 }}<span>{{ section.settings.logo_text_2 }}</span>
        {% endif %}
    </a>

    <!-- Desktop Nav -->
    <div class="pawnest-desktop-nav-{{ section.id }}">
        {% for link in linklists[section.settings.menu].links %}
            <div class="pawnest-nav-item">
                <a href="{{ link.url }}" class="pawnest-nav-link">
                    {{ link.title }} 
                    {% if link.links != blank %}
                        <span class="material-icons-round">expand_more</span>
                    {% endif %}
                </a>
                
                {% if link.links != blank %}
                    <div class="pawnest-dropdown-menu">
                        {% for child_link in link.links %}
                            <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <!-- Icons -->
    <div class="pawnest-header-icons-{{ section.id }}">
        {% if shop.customer_accounts_enabled %}
            <a href="{{ routes.account_url }}" class="pawnest-icon-link" aria-label="Account">
                <span class="material-icons-round">person_outline</span>
            </a>
        {% else %}
            <a href="#" class="pawnest-icon-link" aria-label="Account">
                <span class="material-icons-round">person_outline</span>
            </a>
        {% endif %}
        
        <a href="{{ routes.search_url }}" class="pawnest-icon-link" aria-label="Search">
            <span class="material-icons-round">search</span>
        </a>
        
        <a href="#" class="pawnest-icon-link" aria-label="Store Locator">
            <span class="material-icons-round">storefront</span>
        </a>
        
        <a href="{{ routes.cart_url }}" class="pawnest-icon-link pawnest-cart-icon-wrapper" id="cart-icon-bubble" aria-label="Cart">
            <span class="material-icons-round">shopping_cart_checkout</span>
            {% if cart != empty and cart.item_count > 0 %}
                <span class="cart-count-bubble">
                    {% if cart.item_count < 100 %}
                        {{ cart.item_count }}
                    {% else %}
                        99+
                    {% endif %}
                </span>
            {% endif %}
        </a>
    </div>
</header>

{% schema %}
{
  "name": "App-Style Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "text",
      "id": "logo_text_1",
      "label": "Logo Text Part 1",
      "default": "Pure Paw"
    },
    {
      "type": "text",
      "id": "logo_text_2",
      "label": "Logo Text Part 2",
      "default": "Nest"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Desktop Menu",
      "default": "main-menu"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#D91C29"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary Color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "App-Style Header",
      "category": "PawNest"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
