<style>
    /* Hero CSS - Desktop & Mobile */
    .pawnest-hero-{{ section.id }} {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 80vh;
        padding: 40px 5%;
        background: radial-gradient(circle at top right, {{ section.settings.bg_gradient }} 0%, {{ section.settings.bg_color }} 60%);
        font-family: 'Outfit', sans-serif;
    }
    .hero-content-{{ section.id }} { flex: 1; max-width: 600px; }
    .hero-content-{{ section.id }} h2 { font-size: 64px; font-weight: 900; color: {{ section.settings.text_color }}; line-height: 1.1; margin-bottom: 24px; }
    .hero-content-{{ section.id }} h2 span { color: {{ section.settings.primary_color }}; }
    .hero-content-{{ section.id }} p { font-size: 18px; color: #555; line-height: 1.6; margin-bottom: 40px; }
    
    .hero-btn-{{ section.id }} {
        background: {{ section.settings.primary_color }};
        color: white;
        padding: 16px 45px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 700;
        font-size: 18px;
        box-shadow: 0 10px 25px rgba(255, 126, 103, 0.35);
        transition: all 0.3s ease;
        display: inline-block;
    }
    .hero-btn-{{ section.id }}:hover { transform: translateY(-5px); opacity: 0.9; }

    .hero-image-wrapper-{{ section.id }} { flex: 1; display: flex; justify-content: flex-end; position: relative; }
    .hero-graphics-{{ section.id }} {
        width: 500px; height: 500px;
        border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
        background-image: url('{{ section.settings.image | img_url: "1000x" }}');
        background-size: cover; background-position: center bottom;
        box-shadow: 0 20px 50px rgba(255, 126, 103, 0.3); border: 8px solid white;
    }

    @media (max-width: 768px) {
        .pawnest-hero-{{ section.id }} {
            flex-direction: column; min-height: auto; margin: 15px; border-radius: 20px;
            padding: 30px 20px 100px; position: relative; overflow: hidden;
            background: linear-gradient(135deg, {{ section.settings.bg_gradient }}, {{ section.settings.bg_color }});
        }
        .hero-content-{{ section.id }} h2 { font-size: 32px; z-index: 2; position: relative;}
        .hero-content-{{ section.id }} p { font-size: 14px; max-width: 70%; z-index: 2; position: relative;}
        .hero-btn-{{ section.id }} { padding: 12px 25px; font-size: 14px; border-radius: 20px; z-index: 2; position: relative;}
        
        .hero-image-wrapper-{{ section.id }} { position: absolute; right: -30px; bottom: -30px; z-index: 1; }
        .hero-graphics-{{ section.id }} { width: 180px; height: 180px; border-radius: 50%; border: 4px solid white; }
    }
</style>

<div class="pawnest-hero-{{ section.id }}">
    <div class="hero-content-{{ section.id }}">
        <h2>{{ section.settings.title_1 }} <span>{{ section.settings.title_highlight }}</span> {{ section.settings.title_2 }}</h2>
        <p>{{ section.settings.description }}</p>
        <a href="{{ section.settings.btn_link }}" class="hero-btn-{{ section.id }}">{{ section.settings.btn_text }}</a>
    </div>
    <div class="hero-image-wrapper-{{ section.id }}">
        <div class="hero-graphics-{{ section.id }}" 
             {% if section.settings.image == blank %}
             style="background-image: url('https://images.unsplash.com/photo-1583337130417-3346a1be7dee?q=80&w=1000&auto=format&fit=crop');"
             {% endif %}>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "App-Style Hero",
  "settings": [
    { "type": "text", "id": "title_1", "label": "Title Part 1", "default": "Give Your Pets the" },
    { "type": "text", "id": "title_highlight", "label": "Highlighted Word", "default": "Comfort" },
    { "type": "text", "id": "title_2", "label": "Title Part 2", "default": "They Deserve" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Premium food, stylish clothing, and fun accessories for your furry friends." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Shop Collection" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "color", "id": "primary_color", "label": "Primary Color", "default": "#FF7E67" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#2C3E50" },
    { "type": "color", "id": "bg_gradient", "label": "Background Gradient", "default": "#FFE5DF" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F8F9FA" }
  ],
  "presets": [ { "name": "App-Style Hero", "category": "PawNest" } ]
}
{% endschema %}
