<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
<style>
    .pawnest-hero-wrapper-{{ section.id }} {
        position: relative;
        width: 100%;
        overflow: hidden;
        min-height: 85vh;
        background-color: #111;
    }

    .pawnest-hero-slide-{{ section.id }} {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px 5%;
        background-size: cover;
        background-position: center;
    }

    .pawnest-hero-slide-{{ section.id }}.active {
        opacity: 1;
        visibility: visible;
        z-index: 1;
    }

    .pawnest-hero-slide-{{ section.id }}::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 1;
    }

    .hero-content-{{ section.id }} { 
        position: relative; 
        z-index: 2; 
        max-width: 900px; 
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        transform: translateY(20px);
        opacity: 0;
        transition: transform 0.8s ease 0.3s, opacity 0.8s ease 0.3s;
    }
    
    .pawnest-hero-slide-{{ section.id }}.active .hero-content-{{ section.id }} {
        transform: translateY(0);
        opacity: 1;
    }

    .hero-content-{{ section.id }} h2 { 
        font-family: 'Oswald', sans-serif;
        font-size: 75px; 
        font-weight: 900; 
        color: #ffffff; 
        line-height: 1.1; 
        margin-bottom: 20px; 
        text-transform: uppercase;
        letter-spacing: -1.5px;
    }
    .hero-content-{{ section.id }} h2 span { color: {{ section.settings.primary_color }}; }
    .hero-content-{{ section.id }} p { 
        font-family: 'Outfit', sans-serif;
        font-size: 24px; 
        font-weight: 600;
        color: #ffffff; 
        line-height: 1.4; 
        margin-bottom: 40px; 
        text-shadow: 0 2px 5px rgba(0,0,0,0.4);
    }
    
    .hero-btn-{{ section.id }} {
        background: {{ section.settings.primary_color }};
        color: #ffffff;
        padding: 18px 50px;
        border-radius: 40px;
        text-decoration: none;
        font-family: 'Oswald', sans-serif;
        font-weight: 700;
        font-size: 22px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-block;
    }
    .hero-btn-{{ section.id }}:hover { 
        background: #ffffff; 
        color: {{ section.settings.primary_color }}; 
        transform: translateY(-3px); 
        box-shadow: 0 15px 30px rgba(0,0,0,0.25);
    }

    /* Slider Controls */
    .hero-controls-{{ section.id }} {
        position: absolute;
        bottom: 30px;
        left: 0;
        width: 100%;
        z-index: 10;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
    }

    .hero-dots-{{ section.id }} {
        display: flex;
        gap: 10px;
    }

    .hero-dot-{{ section.id }} {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.5);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .hero-dot-{{ section.id }}.active {
        background: #ffffff;
        transform: scale(1.2);
    }
    
    .hero-arrow-{{ section.id }} {
        background: rgba(0,0,0,0.2);
        color: white;
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.3s;
        backdrop-filter: blur(4px);
    }
    .hero-arrow-{{ section.id }}:hover {
        background: {{ section.settings.primary_color }};
    }

    @media (max-width: 768px) {
        .pawnest-hero-wrapper-{{ section.id }} {
            min-height: 70vh; 
        }
        .pawnest-hero-slide-{{ section.id }} {
            padding: 40px 20px; 
        }
        .hero-content-{{ section.id }} h2 { 
            font-size: 45px; 
            margin-bottom: 12px;
        }
        .hero-content-{{ section.id }} p { 
            font-size: 18px; 
            margin-bottom: 30px;
        }
        .hero-btn-{{ section.id }} { 
            padding: 15px 35px; 
            font-size: 18px; 
        }
        .hero-controls-{{ section.id }} {
            bottom: 20px;
        }
    }
</style>

<div class="pawnest-hero-wrapper-{{ section.id }}" id="heroSlider-{{ section.id }}">
    {% for block in section.blocks %}
        <div class="pawnest-hero-slide-{{ section.id }} {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }} 
             style="background-image: url('{% if block.settings.image != blank %}{{ block.settings.image | img_url: 'master' }}{% else %}https://images.unsplash.com/photo-1583337130417-3346a1be7dee?q=80&w=2000&auto=format&fit=crop{% endif %}');">
            <div class="hero-content-{{ section.id }}">
                <h2>{{ block.settings.title_1 }} <span>{{ block.settings.title_highlight }}</span> {{ block.settings.title_2 }}</h2>
                <p>{{ block.settings.description }}</p>
                <a href="{{ block.settings.btn_link }}" class="hero-btn-{{ section.id }}">{{ block.settings.btn_text }}</a>
            </div>
        </div>
    {% endfor %}

    {% if section.blocks.size > 1 %}
    <div class="hero-controls-{{ section.id }}">
        <button class="hero-arrow-{{ section.id }}" id="prevBtn-{{ section.id }}"><span class="material-icons-round">chevron_left</span></button>
        <div class="hero-dots-{{ section.id }}">
            {% for block in section.blocks %}
                <div class="hero-dot-{{ section.id }} {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
            {% endfor %}
        </div>
        <button class="hero-arrow-{{ section.id }}" id="nextBtn-{{ section.id }}"><span class="material-icons-round">chevron_right</span></button>
    </div>
    {% endif %}
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const wrapper = document.getElementById('heroSlider-{{ section.id }}');
    if (!wrapper) return;
    
    const slides = wrapper.querySelectorAll('.pawnest-hero-slide-{{ section.id }}');
    const dots = wrapper.querySelectorAll('.hero-dot-{{ section.id }}');
    const prevBtn = wrapper.querySelector('#prevBtn-{{ section.id }}');
    const nextBtn = wrapper.querySelector('#nextBtn-{{ section.id }}');
    
    if (slides.length <= 1) return;

    let currentSlide = 0;
    let slideInterval;

    function showSlide(index) {
        slides.forEach(s => s.classList.remove('active'));
        dots.forEach(d => d.classList.remove('active'));
        
        slides[index].classList.add('active');
        if(dots[index]) dots[index].classList.add('active');
        currentSlide = index;
    }

    function nextSlide() {
        let next = (currentSlide + 1) % slides.length;
        showSlide(next);
    }

    function prevSlide() {
        let prev = (currentSlide - 1 + slides.length) % slides.length;
        showSlide(prev);
    }

    function startAutoSlide() {
        slideInterval = setInterval(nextSlide, 5000);
    }

    function resetAutoSlide() {
        clearInterval(slideInterval);
        startAutoSlide();
    }

    if(nextBtn) {
        nextBtn.addEventListener('click', () => {
            nextSlide();
            resetAutoSlide();
        });
    }

    if(prevBtn) {
        prevBtn.addEventListener('click', () => {
            prevSlide();
            resetAutoSlide();
        });
    }

    dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
            showSlide(index);
            resetAutoSlide();
        });
    });

    startAutoSlide();
});
</script>

{% schema %}
{
  "name": "App-Style Hero Slider",
  "settings": [
    { "type": "color", "id": "primary_color", "label": "Primary Color", "default": "#D91C29" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Slide Image" },
        { "type": "text", "id": "title_1", "label": "Title Part 1", "default": "CLASSIC NOW" },
        { "type": "text", "id": "title_highlight", "label": "Highlighted Word", "default": "GOLDEN" },
        { "type": "text", "id": "title_2", "label": "Title Part 2", "default": "" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Our 50th anniversary surprise: the Gold KONG!" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "BUY YOURS NOW" },
        { "type": "url", "id": "btn_link", "label": "Button Link" }
      ]
    }
  ],
  "presets": [ 
    { 
      "name": "App-Style Hero Slider", 
      "category": "PawNest",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    } 
  ]
}
{% endschema %}
