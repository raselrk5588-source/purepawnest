<style>
    .pawnest-newsletter-{{ section.id }} {
        background: linear-gradient(135deg, {{ section.settings.primary_color }} 0%, {{ section.settings.secondary_color }} 100%);
        padding: 60px 5%;
        text-align: center;
        color: white;
        font-family: 'Outfit', sans-serif;
        border-radius: 20px;
        margin: 30px 5%;
    }
    .pawnest-newsletter-title {
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 15px 0;
    }
    .pawnest-newsletter-desc {
        font-size: 16px;
        opacity: 0.9;
        max-width: 500px;
        margin: 0 auto 30px auto;
        line-height: 1.5;
    }
    .pawnest-newsletter-form {
        display: flex;
        max-width: 450px;
        margin: 0 auto;
        background: white;
        border-radius: 50px;
        padding: 5px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .pawnest-newsletter-input {
        flex: 1;
        border: none;
        padding: 15px 20px;
        font-size: 15px;
        border-radius: 50px;
        outline: none;
        color: #333;
        font-family: 'Outfit', sans-serif;
    }
    .pawnest-newsletter-btn {
        background: {{ section.settings.secondary_color }};
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        transition: transform 0.3s ease, background 0.3s ease;
    }
    .pawnest-newsletter-btn:hover {
        transform: scale(1.05);
        background: #1a252f;
    }
    @media (max-width: 768px) {
        .pawnest-newsletter-{{ section.id }} { padding: 40px 20px; border-radius: 0; margin: 30px 0; }
        .pawnest-newsletter-title { font-size: 24px; }
        .pawnest-newsletter-form { flex-direction: column; background: transparent; box-shadow: none; gap: 10px; }
        .pawnest-newsletter-input { border-radius: 12px; padding: 15px; text-align: center; }
        .pawnest-newsletter-btn { border-radius: 12px; padding: 15px; width: 100%; }
    }
</style>

<div class="pawnest-newsletter-{{ section.id }}">
    <h2 class="pawnest-newsletter-title">{{ section.settings.heading }}</h2>
    <p class="pawnest-newsletter-desc">{{ section.settings.subheading }}</p>

    {% form 'customer', class: 'pawnest-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email"
               name="contact[email]"
               id="Email"
               class="pawnest-newsletter-input"
               value="{% if customer %}{{ customer.email }}{% endif %}"
               placeholder="Enter your email address"
               autocorrect="off"
               autocapitalize="off"
               required>
        <button type="submit" class="pawnest-newsletter-btn" name="commit">
            Subscribe
        </button>
    {% endform %}
</div>

{% schema %}
{
  "name": "App-Style Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the PawNest Family 🐾"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subscribe to get special offers, free giveaways, and once-in-a-lifetime deals."
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Gradient Color 1",
      "default": "#FF7E67"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Gradient Color 2",
      "default": "#2C3E50"
    }
  ],
  "presets": [
    {
      "name": "App-Style Newsletter",
      "category": "PawNest"
    }
  ]
}
{% endschema %}
