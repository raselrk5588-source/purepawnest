<style>
    .pawnest-top-products-{{ section.id }} {
        padding: 50px 5%;
        background-color: {{ section.settings.bg_color }};
        font-family: 'Outfit', sans-serif;
    }
    .pawnest-top-products-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
    .pawnest-top-products-title {
        font-size: 28px;
        font-weight: 700;
        color: {{ section.settings.text_color }};
        margin: 0;
    }
    .pawnest-products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
    }
    .pawnest-product-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
    }
    .pawnest-product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    .pawnest-product-image-wrap {
        position: relative;
        padding-top: 100%; /* 1:1 Aspect Ratio */
        background: #f9f9f9;
        overflow: hidden;
    }
    .pawnest-product-image-wrap img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .pawnest-hot-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #FF4757;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        z-index: 2;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .pawnest-product-info {
        padding: 15px;
    }
    .pawnest-product-title {
        font-size: 15px;
        font-weight: 600;
        color: #2C3E50;
        margin: 0 0 8px 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-decoration: none;
    }
    .pawnest-product-price {
        font-size: 16px;
        font-weight: 700;
        color: #FF7E67;
        margin: 0;
    }
    .pawnest-compare-price {
        font-size: 13px;
        color: #95A5A6;
        text-decoration: line-through;
        margin-left: 8px;
        font-weight: 400;
    }
    .pawnest-add-to-cart-btn {
        width: 100%;
        padding: 12px;
        background: #FF7E67;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        margin-top: 12px;
        transition: background 0.3s;
    }
    .pawnest-add-to-cart-btn:hover {
        background: #ff6347;
    }
    .pawnest-view-all {
        color: #FF7E67;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
    }
    .pawnest-view-all:hover {
        text-decoration: underline;
    }
    @media (max-width: 768px) {
        .pawnest-products-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .pawnest-top-products-title { font-size: 22px; }
        .pawnest-top-products-{{ section.id }} { padding: 30px 15px; }
        .pawnest-product-info { padding: 12px; }
        .pawnest-product-title { font-size: 13px; }
        .pawnest-product-price { font-size: 14px; }
    }
</style>

<div class="pawnest-top-products-{{ section.id }}">
    <div class="pawnest-top-products-header">
        <h2 class="pawnest-top-products-title">{{ section.settings.title }}</h2>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
            <a href="{{ section.settings.collection.url }}" class="pawnest-view-all">View All</a>
        {% endif %}
    </div>

    <div class="pawnest-products-grid">
        {% assign collection = section.settings.collection %}
        {% assign product_limit = section.settings.product_limit %}
        
        {% if collection != blank and collection.products_count > 0 %}
            {% for product in collection.products limit: product_limit %}
                <div class="pawnest-product-card">
                    <a href="{{ product.url }}">
                        <div class="pawnest-product-image-wrap">
                            {% if product.tags contains 'Hot' or section.settings.show_hot_badge %}
                                <span class="pawnest-hot-badge">Hot</span>
                            {% endif %}
                            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                        </div>
                    </a>
                    <div class="pawnest-product-info">
                        <a href="{{ product.url }}" class="pawnest-product-title">{{ product.title }}</a>
                        <p class="pawnest-product-price">
                            {{ product.price | money }}
                            {% if product.compare_at_price > product.price %}
                                <span class="pawnest-compare-price">{{ product.compare_at_price | money }}</span>
                            {% endif %}
                        </p>
                        <form method="post" action="/cart/add">
                            <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                            <button type="submit" class="pawnest-add-to-cart-btn" {% unless product.available %}disabled{% endunless %}>
                                {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <!-- Placeholder for Theme Editor -->
            {% for i in (1..4) %}
                <div class="pawnest-product-card">
                    <div class="pawnest-product-image-wrap">
                        <span class="pawnest-hot-badge">Hot</span>
                        {{ 'product-' | append: i | placeholder_svg_tag }}
                    </div>
                    <div class="pawnest-product-info">
                        <p class="pawnest-product-title">Example Hot Product</p>
                        <p class="pawnest-product-price">$29.99 <span class="pawnest-compare-price">$39.99</span></p>
                        <button class="pawnest-add-to-cart-btn">Add to Cart</button>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

{% schema %}
{
  "name": "Hot Top Selling Products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "🔥 30 Hot Top Selling Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 30,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_hot_badge",
      "label": "Show 'HOT' Badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Link",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f7f6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C3E50"
    }
  ],
  "presets": [
    {
      "name": "Hot Top Selling Products",
      "category": "PawNest"
    }
  ]
}
{% endschema %}
