<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
<style>
    .pawnest-bottom-nav {
        display: none;
        font-family: 'Outfit', sans-serif;
    }
    
    @media (max-width: 768px) {
        .pawnest-bottom-nav {
            display: flex;
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: white;
            justify-content: space-around;
            align-items: center;
            box-shadow: 0 -2px 15px rgba(0,0,0,0.05);
            z-index: 2147483647; /* Ensure it stays on top of Shopify UI */
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
        }
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: #555555;
            text-decoration: none;
        }
        .nav-item.active { color: #FF7E67; }
        .nav-item .label { font-size: 11px; font-weight: 600; }
        .nav-item .material-icons-round { font-size: 26px; }
        
        /* Add padding to body so content doesn't hide behind nav */
        body { padding-bottom: 80px !important; }
    }
</style>

<nav class="pawnest-bottom-nav">
    <a href="{{ routes.root_url }}" class="nav-item {% if request.page_type == 'index' %}active{% endif %}">
        <span class="material-icons-round">home</span>
        <span class="label">Home</span>
    </a>
    <a href="{{ routes.all_products_collection_url }}" class="nav-item {% if request.page_type == 'collection' %}active{% endif %}">
        <span class="material-icons-round">category</span>
        <span class="label">Shop</span>
    </a>
    <a href="{{ routes.cart_url }}" class="nav-item {% if request.page_type == 'cart' %}active{% endif %}">
        <span class="material-icons-round">shopping_cart</span>
        <span class="label">Cart ({{ cart.item_count }})</span>
    </a>
    <a href="{{ routes.account_url }}" class="nav-item {% if request.page_type == 'customers/account' %}active{% endif %}">
        <span class="material-icons-round">person</span>
        <span class="label">Profile</span>
    </a>
</nav>

{% schema %}
{
  "name": "App Bottom Navigation",
  "settings": [],
  "presets": [ { "name": "App Bottom Navigation", "category": "PawNest" } ]
}
{% endschema %}
